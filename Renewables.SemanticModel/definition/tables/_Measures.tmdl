table _Measures

	measure 'Operating GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "operating" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pre-construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "pre-construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Announced GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "announced" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Total GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Totals] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Shelved GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "shelved" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Cancelled GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "cancelled" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Construction % of Pipeline' = DIVIDE ( [Construction GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Risk

	measure 'Pipeline to Operating Ratio' = DIVIDE ( [Pipeline GW], [Operating GW] )
		formatString: #,0"×"
		displayFolder: Risk

	measure 'Hydrogen Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE (), 'Unit'[Hydrogen] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Hydrogen

	measure 'Hydrogen % of Pipeline' = DIVIDE ( [Hydrogen Pipeline GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Hydrogen

	measure 'Wind Solar TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Wind Solar TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Wind Solar TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Emissions MtCO2e' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Emissions MtCO2e] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Emissions MtCO2e] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Total Generation TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Total Generation TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Total Generation TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		displayFolder: Generation

	measure 'Wind Solar Share %' = DIVIDE ( [Wind Solar TWh], [Total Generation TWh] )
		formatString: 0.0%
		displayFolder: Generation

	measure 'Emissions Intensity g/kWh' = DIVIDE ( [Emissions MtCO2e], [Total Generation TWh] ) * 1000
		formatString: #,0
		displayFolder: Generation

	measure 'Ember Year' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    FORMAT ( SELECTEDVALUE ( 'Generation'[Year] ), "0" ),
			    VAR FirstYear = MIN ( 'Country'[Ember Latest Year] )
			    VAR LastYear = MAX ( 'Country'[Ember Latest Year] )
			    RETURN
			        IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "–" & FORMAT ( LastYear, "0" ) )
			)
		displayFolder: Generation

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source
