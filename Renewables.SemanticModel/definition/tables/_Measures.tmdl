table _Measures

	measure 'Operating GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "operating" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pre-construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "pre-construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Announced GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "announced" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Total GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Totals] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Shelved GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "shelved" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Cancelled GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "cancelled" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Construction % of Pipeline' = DIVIDE ( [Construction GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Risk

	measure 'Pipeline to Operating Ratio' = DIVIDE ( [Pipeline GW], [Operating GW] )
		formatString: #,0"×"
		displayFolder: Risk

	measure 'Hydrogen Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE (), 'Unit'[Hydrogen] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Hydrogen

	measure 'Hydrogen % of Pipeline' = DIVIDE ( [Hydrogen Pipeline GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Hydrogen

	measure 'Wind Solar TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Wind Solar TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Wind Solar TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Emissions MtCO2e' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Emissions MtCO2e] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Emissions MtCO2e] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Total Generation TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Total Generation TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Total Generation TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		displayFolder: Generation

	measure 'Wind Solar Share %' = DIVIDE ( [Wind Solar TWh], [Total Generation TWh] )
		formatString: 0.0%
		displayFolder: Generation

	measure 'Emissions Intensity g/kWh' = DIVIDE ( [Emissions MtCO2e], [Total Generation TWh] ) * 1000
		formatString: #,0
		displayFolder: Generation

	measure 'Language Code' = SELECTEDVALUE ( 'Language'[Code], "en" )
		isHidden
		displayFolder: Text

	measure 'Scope Text' =
			VAR CountriesInContext = COUNTROWS ( 'Country' )
			VAR AllCountries = CALCULATE ( COUNTROWS ( 'Country' ), REMOVEFILTERS ( 'Country' ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CountriesInContext = AllCountries, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.region" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.region" ) ),
			        CountriesInContext = 1, IF ( [Language Code] = "ar", SELECTEDVALUE ( 'Country'[Country AR] ), SELECTEDVALUE ( 'Country'[Country] ) ),
			        IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.selected" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.selected" ) )
			    )
		isHidden
		displayFolder: Text

	measure 'Scope Possessive Text' =
			VAR CountriesInContext = COUNTROWS ( 'Country' )
			VAR AllCountries = CALCULATE ( COUNTROWS ( 'Country' ), REMOVEFILTERS ( 'Country' ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CountriesInContext = AllCountries, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.region.possessive" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.region.possessive" ) ),
			        CountriesInContext = 1, [Scope Text] & IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.country.possessive-suffix" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.country.possessive-suffix" ) ),
			        IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.selected.possessive" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.selected.possessive" ) )
			    )
		isHidden
		displayFolder: Text

	measure 'Headline Overview' =
			VAR SentenceText =
			VAR Focus = SELECTEDVALUE ( 'Overview Focus'[Code], "construction" )
			VAR Construction = [Construction GW]
			VAR Operating = [Operating GW]
			VAR Scale =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( Construction > Operating, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.scale.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.scale.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.scale.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.scale.neutral" ) ) ), "{construction}", IF ( Construction > 0 && Construction < 0.05, "<0.1", FORMAT ( Construction, "#,0.0", "en-GB" ) ) ), "{operating}", IF ( Operating > 0 && Operating < 0.05, "<0.1", FORMAT ( Operating, "#,0.0", "en-GB" ) ) ), "{share}", FORMAT ( [Wind Solar Share %], "0.0%", "en-GB" ) ), "{scope_pos}", [Scope Possessive Text] ), "{years}", [Ember Year] )
			-- Latest full year: the GEM release (Sep 2026) is part-way through 2026
			VAR ReleaseYear = 2026
			VAR LatestYear = CALCULATE ( MAX ( 'Unit'[Start Year] ), 'Status'[Status ID] = "operating", 'Unit'[Start Year] < ReleaseYear )
			VAR Added = CALCULATE ( [Operating GW], 'Unit'[Start Year] = LatestYear )
			VAR Decade = CALCULATE ( [Operating GW], 'Unit'[Start Year] >= 2010, 'Unit'[Start Year] <= 2019 )
			VAR Speed =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( Added > Decade, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.speed.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.speed.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.speed.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.speed.neutral" ) ) ), "{added}", IF ( Added > 0 && Added < 0.05, "<0.1", FORMAT ( Added, "#,0.0", "en-GB" ) ) ), "{year}", FORMAT ( LatestYear, "0" ) ), "{decade}", IF ( Decade > 0 && Decade < 0.05, "<0.1", FORMAT ( Decade, "#,0.0", "en-GB" ) ) )
			RETURN
			    IF ( Focus = "operating", Speed, Scale )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Headlines

	measure 'Headline Breakdown' =
			VAR SentenceText =
			VAR Pipeline = [Pipeline GW]
			VAR ConstructionShare = COALESCE ( [Construction % of Pipeline], 0 )
			-- Below this share of the pipeline, construction is called out as "only"
			VAR OnlyThreshold = 0.25
			VAR Main =
			    SUBSTITUTE ( SUBSTITUTE ( SWITCH ( TRUE (), ConstructionShare = 0, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.none-building" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.none-building" ) ), ConstructionShare < OnlyThreshold, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.neutral" ) ) ), "{construction_pct}", FORMAT ( ConstructionShare, "0.0%", "en-GB" ) ), "{pipeline}", IF ( Pipeline > 0 && Pipeline < 0.05, "<0.1", FORMAT ( Pipeline, "#,0.0", "en-GB" ) ) )
			VAR TopCountry = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Country'[Country ID] ), "@Pipeline", [Pipeline GW] ), [@Pipeline], DESC )
			VAR TopName = MAXX ( TopCountry, IF ( [Language Code] = "ar", CALCULATE ( MAX ( 'Country'[Country AR] ) ), CALCULATE ( MAX ( 'Country'[Country] ) ) ) )
			VAR TopPart =
			    SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.top-country" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.top-country" ) ), "{top_country}", TopName ), "{top_country_pipeline}", IF ( MAXX ( TopCountry, [@Pipeline] ) > 0 && MAXX ( TopCountry, [@Pipeline] ) < 0.05, "<0.1", FORMAT ( MAXX ( TopCountry, [@Pipeline] ), "#,0.0", "en-GB" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Pipeline ), SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.no-pipeline" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.no-pipeline" ) ), "{scope}", [Scope Text] ),
			        COUNTROWS ( 'Country' ) > 1, Main & TopPart,
			        Main & "."
			    )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Headlines

	measure 'Headline Opportunity' =
			VAR SentenceText =
			VAR TopBuilder = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Country'[Country ID] ), "@Construction", [Construction GW] ), [@Construction], DESC )
			VAR TopGW = MAXX ( TopBuilder, [@Construction] )
			VAR Sentence =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( COUNTROWS ( 'Country' ) > 1, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.neutral" ) ) ), "{top_builder}", MAXX ( TopBuilder, IF ( [Language Code] = "ar", CALCULATE ( MAX ( 'Country'[Country AR] ) ), CALCULATE ( MAX ( 'Country'[Country] ) ) ) ) ), "{top_builder_gw}", IF ( TopGW > 0 && TopGW < 0.05, "<0.1", FORMAT ( TopGW, "#,0.0", "en-GB" ) ) ), "{top_builder_share}", FORMAT ( MAXX ( TopBuilder, [Wind Solar Share %] ), "0.0%", "en-GB" ) ), "{year}", MAXX ( TopBuilder, [Ember Year] ) )
			RETURN
			    IF ( TopGW > 0, Sentence, SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.none" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.none" ) ), "{scope}", [Scope Text] ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Headlines

	measure 'Headline Detail' =
			VAR SentenceText =
			VAR Projects = FILTER ( ADDCOLUMNS ( VALUES ( 'Unit'[Plant ID] ), "@Pipeline", [Pipeline GW] ), [@Pipeline] > 0 )
			VAR ProjectCount = COUNTROWS ( Projects )
			VAR Top10Share = DIVIDE ( SUMX ( TOPN ( 10, Projects, [@Pipeline], DESC ), [@Pipeline] ), [Pipeline GW] )
			VAR HydrogenShare = [Hydrogen % of Pipeline]
			VAR Main =
			    IF (
			        ProjectCount > 10,
			        SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.claim" ) ), "{top10_pct}", FORMAT ( Top10Share, "0.0%", "en-GB" ) ), "{scope_pos}", [Scope Possessive Text] ),
			        IF (
			            ProjectCount = 1,
			            SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.neutral-single" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.neutral-single" ) ), "{scope}", [Scope Text] ),
			            SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.neutral" ) ), "{projects}", FORMAT ( ProjectCount, "0" ) ), "{scope}", [Scope Text] )
			        )
			    )
			VAR HydrogenPart = SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.hydrogen" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.hydrogen" ) ), "{hydrogen_pct}", FORMAT ( HydrogenShare, "0.0%", "en-GB" ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ProjectCount = 0 || ISBLANK ( ProjectCount ), SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.no-pipeline" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.no-pipeline" ) ), "{scope}", [Scope Text] ),
			        HydrogenShare > 0, Main & HydrogenPart,
			        Main & "."
			    )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Headlines

	measure 'Footer Refreshed' =
			VAR SentenceText =
			SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "footer.refreshed" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "footer.refreshed" ) ), "{date}", FORMAT ( MAX ( 'Refresh Info'[Refreshed At UTC] ), "dd mmm yy, HH:mm", "en-GB" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Footer

	measure 'Footer Data To' =
			VAR SentenceText =
			VAR FirstYear = CALCULATE ( MIN ( 'Country'[Ember Latest Year] ), REMOVEFILTERS ( 'Country' ) )
			VAR LastYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ), REMOVEFILTERS ( 'Country' ) )
			VAR Years = IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "–" & FORMAT ( LastYear, "0" ) )
			RETURN
			    SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "footer.data-to" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "footer.data-to" ) ), "{years}", Years )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Footer

	measure 'Full Coverage Year' =
			-- Latest Ember year in which every country in context has data
			MAXX (
			    FILTER (
			        ALL ( 'Generation'[Year] ),
			        CALCULATE ( DISTINCTCOUNT ( 'Generation'[Country ID] ) ) = COUNTROWS ( 'Country' )
			    ),
			    'Generation'[Year]
			)
		formatString: 0
		isHidden
		displayFolder: Generation

	measure 'Wind Solar Share % Full Coverage' =
			VAR CoverageYear = [Full Coverage Year]
			RETURN CALCULATE ( [Wind Solar Share %], 'Generation'[Year] = CoverageYear )
		formatString: 0.0%
		displayFolder: Generation

	measure 'World Wind Solar Share %' =
			-- One year in context (a year axis): that year. Otherwise: the full-coverage year, to compare like with like
			VAR ShareYear = IF ( HASONEVALUE ( 'Generation'[Year] ), VALUES ( 'Generation'[Year] ), [Full Coverage Year] )
			RETURN
			    IF (
			        NOT ISBLANK ( ShareYear ),
			        CALCULATE (
			            DIVIDE ( SUM ( 'World Generation'[Wind Solar TWh] ), SUM ( 'World Generation'[Total Generation TWh] ) ),
			            'World Generation'[Year] = ShareYear
			        )
			    )
		formatString: 0.0%
		displayFolder: Generation

	measure 'Wind Solar Share Last Point' = IF ( SELECTEDVALUE ( 'Generation'[Year] ) = [Full Coverage Year], [Wind Solar Share %] )
		formatString: 0.0%
		isHidden
		displayFolder: Generation

	measure 'KPI Share Status' =
			VAR SentenceText =
			VAR Region = [Wind Solar Share % Full Coverage]
			VAR World = [World Wind Solar Share %]
			VAR Gap = ABS ( World - Region ) * 100
			RETURN
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( Region < World, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.share.below" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.share.below" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.share.above" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.share.above" ) ) ), "{gap}", FORMAT ( Gap, "0.0", "en-GB" ) ), "{world}", FORMAT ( World, "0.0%", "en-GB" ) ), "{year}", FORMAT ( [Full Coverage Year], "0" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'Latest Full Year' =
			-- The GEM release (Sep 2026) is part-way through 2026
			VAR ReleaseYear = 2026
			RETURN
			    CALCULATE ( MAX ( 'Unit'[Start Year] ), 'Status'[Status ID] = "operating", 'Unit'[Start Year] < ReleaseYear, REMOVEFILTERS ( 'Unit'[Start Year] ) )
		formatString: 0
		isHidden
		displayFolder: Capacity

	measure 'KPI Operating Status' =
			VAR SentenceText =
			VAR LatestYear = [Latest Full Year]
			VAR Added = CALCULATE ( [Operating GW], 'Unit'[Start Year] = LatestYear )
			RETURN
			    SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.operating.added" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.operating.added" ) ), "{added}", IF ( Added > 0 && Added < 0.05, "<0.1", FORMAT ( Added, "#,0.0", "en-GB" ) ) ), "{year}", FORMAT ( LatestYear, "0" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'KPI Pipeline Status' =
			VAR SentenceText =
			VAR ConstructionShare = COALESCE ( [Construction % of Pipeline], 0 )
			RETURN
			    SUBSTITUTE ( IF ( ConstructionShare < 0.25, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.pipeline.only" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.pipeline.only" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.pipeline.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.pipeline.neutral" ) ) ), "{pct}", FORMAT ( ConstructionShare, "0.0%", "en-GB" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'Construction % of Total Label' =
			-- Detail label: hidden under 1%, where it would round to 0%
			VAR Share = [Construction % of Total]
			RETURN IF ( Share >= 0.01, Share )
		formatString: 0%
		isHidden
		displayFolder: Risk

	measure 'Share of Pipeline %' = DIVIDE ( [Total GW], CALCULATE ( [Pipeline GW], REMOVEFILTERS ( 'Status' ) ) )
		formatString: 0%
		displayFolder: Risk

	measure 'Construction % of Total' = DIVIDE ( [Construction GW], CALCULATE ( [Construction GW], ALLSELECTED ( 'Country' ) ) )
		formatString: 0%
		displayFolder: Risk

	measure 'Capacity MW' = SUM ( 'Unit'[Capacity MW] )
		formatString: #,0
		displayFolder: Capacity

	measure 'Dropped GW' = [Shelved GW] + [Cancelled GW]
		formatString: #,0.0
		displayFolder: Risk

	measure 'Owner Operating GW' = DIVIDE ( CALCULATE ( SUMX ( 'Ownership', 'Ownership'[Share] * RELATED ( 'Unit'[Capacity MW] ) ), 'Status'[Status ID] = "operating" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Top 10 Owner Operating GW' =
			-- Ten owners with the most operating capacity (share-weighted)
			VAR OwnerRank = RANKX ( ALLSELECTED ( 'Ownership'[Owner] ), [Owner Operating GW], , DESC )
			RETURN IF ( OwnerRank <= 10, [Owner Operating GW] )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Top 10 Pipeline GW' =
			-- Ten largest pipeline projects; ranked across statuses so a stacked bar keeps the same ten
			VAR ProjectGW = CALCULATE ( [Pipeline GW], REMOVEFILTERS ( 'Status' ) )
			VAR ProjectRank = RANKX ( ALLSELECTED ( 'Plant' ), CALCULATE ( [Pipeline GW], REMOVEFILTERS ( 'Status' ) ), ProjectGW, DESC )
			RETURN IF ( ProjectRank <= 10 && ProjectGW > 0, [Pipeline GW] )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Top 3 Construction GW' =
			VAR CountryRank = RANKX ( ALLSELECTED ( 'Country' ), [Construction GW], , DESC )
			RETURN IF ( CountryRank <= 3 && [Construction GW] > 0, [Construction GW] )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Hydrogen Marker' = IF ( CALCULATE ( [Hydrogen Pipeline GW], REMOVEFILTERS ( 'Status' ) ) > 0, "H₂" )
		isHidden
		displayFolder: Hydrogen

	measure 'Emissions Intensity Last Point' = IF ( SELECTEDVALUE ( 'Generation'[Year] ) = [Full Coverage Year], [Emissions Intensity g/kWh] )
		formatString: #,0
		isHidden
		displayFolder: Generation

	measure 'Emissions Intensity Full Coverage' =
			VAR CoverageYear = [Full Coverage Year]
			RETURN CALCULATE ( [Emissions Intensity g/kWh], 'Generation'[Year] = CoverageYear )
		formatString: #,0
		displayFolder: Generation

	measure 'KPI Risk Status' =
			VAR SentenceText =
			SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.risk.split" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.risk.split" ) ), "{shelved}", IF ( [Shelved GW] > 0 && [Shelved GW] < 0.05, "<0.1", FORMAT ( [Shelved GW], "#,0.0", "en-GB" ) ) ), "{cancelled}", IF ( [Cancelled GW] > 0 && [Cancelled GW] < 0.05, "<0.1", FORMAT ( [Cancelled GW], "#,0.0", "en-GB" ) ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'KPI Hydrogen Status' =
			VAR SentenceText =
			SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.hydrogen.share" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.hydrogen.share" ) ), "{pct}", FORMAT ( COALESCE ( [Hydrogen % of Pipeline], 0 ), "0.0%", "en-GB" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'KPI Intensity Status' =
			VAR SentenceText =
			SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.intensity.year" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.intensity.year" ) ), "{year}", FORMAT ( [Full Coverage Year], "0" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'KPI Announced Status' =
			VAR SentenceText =
			SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.announced.share" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.announced.share" ) ), "{pct}", FORMAT ( COALESCE ( DIVIDE ( [Announced GW], [Pipeline GW] ), 0 ), "0.0%", "en-GB" ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'KPI Construction Status' =
			VAR SentenceText =
			SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "kpi.construction.vs-operating" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "kpi.construction.vs-operating" ) ), "{operating}", IF ( [Operating GW] > 0 && [Operating GW] < 0.05, "<0.1", FORMAT ( [Operating GW], "#,0.0", "en-GB" ) ) )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'Wind Solar Share % Full Coverage Text' = FORMAT ( [Wind Solar Share % Full Coverage], "0.0%", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Operating GW Text' = FORMAT ( [Operating GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Pipeline GW Text' = FORMAT ( [Pipeline GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Hydrogen Pipeline GW Text' = FORMAT ( [Hydrogen Pipeline GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Dropped GW Text' = FORMAT ( [Dropped GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Emissions Intensity Full Coverage Text' = FORMAT ( [Emissions Intensity Full Coverage], "#,0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Construction GW Text' = FORMAT ( [Construction GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Announced GW Text' = FORMAT ( [Announced GW], "#,0.0", "en-GB" )
		isHidden
		displayFolder: KPI values

	measure 'Footer Status' =
			VAR SentenceText =
			[Footer Refreshed] & "  ·  " & [Footer Data To]
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Footer

	measure 'Technology Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Technology'[Group Sort Order] ),
			    1, "#daa932",
			    2, "#189e8c",
			    3, "#3a70b3",
			    4, "#b3b2ac"
			)
		isHidden
		displayFolder: Formatting

	measure 'Technology Colour Faded' =
			SWITCH (
			    SELECTEDVALUE ( 'Technology'[Group Sort Order] ),
			    1, "#f0ddad",
			    2, "#a3d8d1",
			    3, "#b0c6e1",
			    4, "#e1e0de"
			)
		isHidden
		displayFolder: Formatting

	measure 'Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Status'[Status ID] ),
			    "operating", "#2b2570",
			    "construction", "#4a3fb0",
			    "pre-construction", "#7368d9",
			    "announced", "#a49cea",
			    "shelved", "#9e9d97",
			    "cancelled", "#9e9d97",
			    "#d3d2cc"
			)
		isHidden
		displayFolder: Formatting

	measure 'Status Colour Faded' =
			SWITCH (
			    SELECTEDVALUE ( 'Status'[Status ID] ),
			    "operating", "#aaa8c6",
			    "construction", "#b7b2df",
			    "pre-construction", "#c7c3f0",
			    "announced", "#dbd7f7",
			    "shelved", "#d8d8d5",
			    "cancelled", "#d8d8d5",
			    "#e1e0de"
			)
		isHidden
		displayFolder: Formatting

	measure 'Top Builder Colour' =
			-- Accent on the country building the most; ALLEXCEPT stops the bar's own country filter leaking in
			VAR TopBuilder =
			    TOPN (
			        1,
			        ADDCOLUMNS ( ALL ( 'Country'[Country ID] ), "@Construction", CALCULATE ( [Construction GW], ALLEXCEPT ( 'Country', 'Country'[Country ID] ) ) ),
			        [@Construction], DESC
			    )
			RETURN
			    IF ( SELECTEDVALUE ( 'Country'[Country ID] ) IN SELECTCOLUMNS ( TopBuilder, "ID", 'Country'[Country ID] ), [Accent Colour], [Neutral Colour] )
		isHidden
		displayFolder: Formatting

	measure 'Accent Colour' = "#eb6834"
		isHidden
		displayFolder: Formatting

	measure 'Neutral Colour' = "#d3d2cc"
		isHidden
		displayFolder: Formatting

	measure 'Total GW Bar Max' = 1.6 * MAXX ( VALUES ( 'Status'[Status ID] ), [Total GW] )
		isHidden
		displayFolder: Formatting

	measure 'Dropped GW Bar Max' = 1.3 * MAXX ( VALUES ( 'Status'[Status ID] ), [Dropped GW] )
		isHidden
		displayFolder: Formatting

	measure 'Top 3 Construction GW Bar Max' = 1.3 * MAXX ( VALUES ( 'Country'[Country ID] ), [Top 3 Construction GW] )
		isHidden
		displayFolder: Formatting

	measure 'Share Gap Axis Min' = 1.3 * MIN ( 0, MINX ( VALUES ( 'Country'[Country ID] ), [Share Gap to World pts] ) )
		isHidden
		displayFolder: Formatting

	measure 'Share Gap Axis Max' = 1.3 * MAX ( 0, MAXX ( VALUES ( 'Country'[Country ID] ), [Share Gap to World pts] ) )
		isHidden
		displayFolder: Formatting

	measure 'Scorecard Share %' = [Wind Solar Share %]
		displayFolder: Scorecard
		formatStringDefinition =
			-- ▲ / ▼ against the world share in the same year (the country's latest Ember year unless a year is chosen)
			VAR ShareYear = IF ( ISFILTERED ( 'Generation'[Year] ), SELECTEDVALUE ( 'Generation'[Year] ), MAX ( 'Country'[Ember Latest Year] ) )
			VAR World =
			    CALCULATE (
			        DIVIDE ( SUM ( 'World Generation'[Wind Solar TWh] ), SUM ( 'World Generation'[Total Generation TWh] ) ),
			        'World Generation'[Year] = ShareYear
			    )
			RETURN
			    IF (
			        ISBLANK ( SELECTEDMEASURE () ) || ISBLANK ( World ),
			        "0.0%",
			        "0.0%" & IF ( SELECTEDMEASURE () >= World, """ ▲""", """ ▼""" )
			    )

	measure 'Scorecard Pipeline GW' = [Pipeline GW]
		displayFolder: Scorecard
		formatStringDefinition =
			-- Pipeline as a multiple of operating capacity, e.g. 101.4 · 11×; skipped below 0.1 GW, where it means nothing
			VAR Ratio = [Pipeline to Operating Ratio]
			RETURN
			    IF (
			        [Operating GW] < 0.1 || SELECTEDMEASURE () < 0.1,
			        "#,0.0",
			        "#,0.0" & """ · " & FORMAT ( Ratio, IF ( Ratio < 10, "0.0", "#,0" ), "en-GB" ) & "×"""
			    )

	measure 'Status Dot' = IF ( NOT ISBLANK ( [Capacity MW] ), "●" )
		displayFolder: Scorecard

	measure 'Ember Year' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    FORMAT ( SELECTEDVALUE ( 'Generation'[Year] ), "0" ),
			    VAR FirstYear = MIN ( 'Country'[Ember Latest Year] )
			    VAR LastYear = MAX ( 'Country'[Ember Latest Year] )
			    RETURN
			        IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "–" & FORMAT ( LastYear, "0" ) )
			)
		displayFolder: Generation

	measure 'Operating GW Cumulative' =
			-- Operating capacity built by the end of each year; units with no start year count from the start
			VAR LastYear = MAX ( 'Unit'[Start Year] )
			RETURN
			    CALCULATE ( [Operating GW], REMOVEFILTERS ( 'Unit'[Start Year] ), 'Unit'[Start Year] <= LastYear || ISBLANK ( 'Unit'[Start Year] ) )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Operating Cumulative Last Point' = IF ( SELECTEDVALUE ( 'Unit'[Start Year] ) = [Latest Full Year], [Operating GW Cumulative] )
		formatString: #,0.0
		isHidden
		displayFolder: Capacity

	measure 'Operating GW Cumulative Axis Max' = 1.3 * MAXX ( VALUES ( 'Unit'[Start Year] ), [Operating GW Cumulative] )
		isHidden
		displayFolder: Formatting

	measure 'Online Label GW' =
			-- Label only the latest full year and the expected years; the value axis carries the rest
			IF ( SELECTEDVALUE ( 'Unit'[Start Year] ) >= [Latest Full Year], [Operating GW] + [Construction GW] )
		formatString: #,0.0
		isHidden
		displayFolder: Capacity

	measure 'Note Expected Coverage' =
			VAR SentenceText =
			VAR Construction = [Construction GW]
			VAR Dated = CALCULATE ( [Construction GW], NOT ISBLANK ( 'Unit'[Start Year] ) )
			VAR Undated = Construction - COALESCE ( Dated, 0 )
			RETURN
			    IF (
			        Construction > 0,
			        SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "note.expected-coverage" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "note.expected-coverage" ) ), "{pct}", FORMAT ( DIVIDE ( Dated, Construction, 0 ), "0%", "en-GB" ) ), "{construction}", FORMAT ( Construction, "#,0.0", "en-GB" ) ), "{undated}", IF ( Undated > 0 && Undated < 0.05, "<0.1", FORMAT ( Undated, "#,0.0", "en-GB" ) ) )
			    )
			RETURN
			    IF ( [Language Code] = "ar", UNICHAR ( 8235 ) & SentenceText & UNICHAR ( 8236 ), SentenceText )
		displayFolder: Text

	measure 'Non-hydrogen Pipeline GW' =
			-- The rest of the pipeline, only in countries with some hydrogen-tied capacity
			IF ( [Hydrogen Pipeline GW] > 0, [Pipeline GW] - [Hydrogen Pipeline GW] )
		formatString: #,0.0
		displayFolder: Hydrogen

	measure 'Hydrogen % of Pipeline Label' =
			-- Detail label: hidden under 1%, where it would round to 0%
			VAR Share = [Hydrogen % of Pipeline]
			RETURN IF ( Share >= 0.01, Share )
		formatString: 0%
		isHidden
		displayFolder: Hydrogen

	measure 'Share Gap to World pts' =
			-- Wind + solar share minus the world's in the same year (the country's latest Ember year), in percentage points
			VAR ShareYear = MAX ( 'Country'[Ember Latest Year] )
			VAR World =
			    CALCULATE (
			        DIVIDE ( SUM ( 'World Generation'[Wind Solar TWh] ), SUM ( 'World Generation'[Total Generation TWh] ) ),
			        'World Generation'[Year] = ShareYear
			    )
			VAR Share = [Wind Solar Share %]
			RETURN
			    IF ( HASONEVALUE ( 'Country'[Country ID] ) && NOT ISBLANK ( Share ) && NOT ISBLANK ( World ), ( Share - World ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: Generation

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source
