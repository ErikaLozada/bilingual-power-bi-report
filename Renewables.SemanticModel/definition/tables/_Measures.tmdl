table _Measures

	measure 'Operating GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "operating" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pre-construction GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "pre-construction" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Announced GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "announced" ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Total GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Totals] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Capacity

	measure 'Shelved GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "shelved" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Cancelled GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[Status ID] = "cancelled" ), 1000 )
		formatString: #,0.0
		displayFolder: Risk

	measure 'Construction % of Pipeline' = DIVIDE ( [Construction GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Risk

	measure 'Pipeline to Operating Ratio' = DIVIDE ( [Pipeline GW], [Operating GW] )
		formatString: #,0"×"
		displayFolder: Risk

	measure 'Hydrogen Pipeline GW' = DIVIDE ( CALCULATE ( SUM ( 'Unit'[Capacity MW] ), 'Status'[In Pipeline] = TRUE (), 'Unit'[Hydrogen] = TRUE () ), 1000 )
		formatString: #,0.0
		displayFolder: Hydrogen

	measure 'Hydrogen % of Pipeline' = DIVIDE ( [Hydrogen Pipeline GW], [Pipeline GW] )
		formatString: 0.0%
		displayFolder: Hydrogen

	measure 'Wind Solar TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Wind Solar TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Wind Solar TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Emissions MtCO2e' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Emissions MtCO2e] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Emissions MtCO2e] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		isHidden
		displayFolder: Generation

	measure 'Total Generation TWh' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    VAR CountriesInContext = COUNTROWS ( 'Country' )
			    VAR CountriesWithData = DISTINCTCOUNT ( 'Generation'[Country ID] )
			    RETURN
			        IF (
			            HASONEVALUE ( 'Generation'[Year] ) && CountriesWithData = CountriesInContext,
			            SUM ( 'Generation'[Total Generation TWh] )
			        ),
			    SUMX (
			        VALUES ( 'Country'[Country ID] ),
			        VAR LatestYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ) )
			        RETURN CALCULATE ( SUM ( 'Generation'[Total Generation TWh] ), 'Generation'[Year] = LatestYear )
			    )
			)
		formatString: #,0.0
		displayFolder: Generation

	measure 'Wind Solar Share %' = DIVIDE ( [Wind Solar TWh], [Total Generation TWh] )
		formatString: 0.0%
		displayFolder: Generation

	measure 'Emissions Intensity g/kWh' = DIVIDE ( [Emissions MtCO2e], [Total Generation TWh] ) * 1000
		formatString: #,0
		displayFolder: Generation

	measure 'Language Code' = SELECTEDVALUE ( 'Language'[Code], "en" )
		isHidden
		displayFolder: Text

	measure 'Scope Text' =
			VAR CountriesInContext = COUNTROWS ( 'Country' )
			VAR AllCountries = CALCULATE ( COUNTROWS ( 'Country' ), REMOVEFILTERS ( 'Country' ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CountriesInContext = AllCountries, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.region" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.region" ) ),
			        CountriesInContext = 1, IF ( [Language Code] = "ar", SELECTEDVALUE ( 'Country'[Country AR] ), SELECTEDVALUE ( 'Country'[Country] ) ),
			        IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.selected" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.selected" ) )
			    )
		isHidden
		displayFolder: Text

	measure 'Scope Possessive Text' =
			VAR CountriesInContext = COUNTROWS ( 'Country' )
			VAR AllCountries = CALCULATE ( COUNTROWS ( 'Country' ), REMOVEFILTERS ( 'Country' ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CountriesInContext = AllCountries, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.region.possessive" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.region.possessive" ) ),
			        CountriesInContext = 1, [Scope Text] & IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.country.possessive-suffix" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.country.possessive-suffix" ) ),
			        IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "scope.selected.possessive" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "scope.selected.possessive" ) )
			    )
		isHidden
		displayFolder: Text

	measure 'Headline Overview' =
			VAR Focus = SELECTEDVALUE ( 'Overview Focus'[Code], "construction" )
			VAR Construction = [Construction GW]
			VAR Operating = [Operating GW]
			VAR Scale =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( Construction > Operating, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.scale.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.scale.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.scale.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.scale.neutral" ) ) ), "{construction}", IF ( Construction > 0 && Construction < 0.05, "<0.1", FORMAT ( Construction, "#,0.0", "en-GB" ) ) ), "{operating}", IF ( Operating > 0 && Operating < 0.05, "<0.1", FORMAT ( Operating, "#,0.0", "en-GB" ) ) ), "{share}", FORMAT ( [Wind Solar Share %], "0.0%", "en-GB" ) ), "{scope_pos}", [Scope Possessive Text] ), "{years}", [Ember Year] )
			-- Latest full year: the GEM release (Sep 2026) is part-way through 2026
			VAR ReleaseYear = 2026
			VAR LatestYear = CALCULATE ( MAX ( 'Unit'[Start Year] ), 'Status'[Status ID] = "operating", 'Unit'[Start Year] < ReleaseYear )
			VAR Added = CALCULATE ( [Operating GW], 'Unit'[Start Year] = LatestYear )
			VAR Decade = CALCULATE ( [Operating GW], 'Unit'[Start Year] >= 2010, 'Unit'[Start Year] <= 2019 )
			VAR Speed =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( Added > Decade, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.speed.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.speed.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.overview.speed.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.overview.speed.neutral" ) ) ), "{added}", IF ( Added > 0 && Added < 0.05, "<0.1", FORMAT ( Added, "#,0.0", "en-GB" ) ) ), "{year}", FORMAT ( LatestYear, "0" ) ), "{decade}", IF ( Decade > 0 && Decade < 0.05, "<0.1", FORMAT ( Decade, "#,0.0", "en-GB" ) ) )
			RETURN
			    IF ( Focus = "operating", Speed, Scale )
		displayFolder: Headlines

	measure 'Headline Breakdown' =
			VAR Pipeline = [Pipeline GW]
			VAR ConstructionShare = COALESCE ( [Construction % of Pipeline], 0 )
			-- Below this share of the pipeline, construction is called out as "only"
			VAR OnlyThreshold = 0.25
			VAR Main =
			    SUBSTITUTE ( SUBSTITUTE ( SWITCH ( TRUE (), ConstructionShare = 0, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.none-building" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.none-building" ) ), ConstructionShare < OnlyThreshold, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.neutral" ) ) ), "{construction_pct}", FORMAT ( ConstructionShare, "0.0%", "en-GB" ) ), "{pipeline}", IF ( Pipeline > 0 && Pipeline < 0.05, "<0.1", FORMAT ( Pipeline, "#,0.0", "en-GB" ) ) )
			VAR TopCountry = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Country'[Country ID] ), "@Pipeline", [Pipeline GW] ), [@Pipeline], DESC )
			VAR TopName = MAXX ( TopCountry, IF ( [Language Code] = "ar", CALCULATE ( MAX ( 'Country'[Country AR] ) ), CALCULATE ( MAX ( 'Country'[Country] ) ) ) )
			VAR TopPart =
			    SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.breakdown.top-country" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.breakdown.top-country" ) ), "{top_country}", TopName ), "{top_country_pipeline}", IF ( MAXX ( TopCountry, [@Pipeline] ) > 0 && MAXX ( TopCountry, [@Pipeline] ) < 0.05, "<0.1", FORMAT ( MAXX ( TopCountry, [@Pipeline] ), "#,0.0", "en-GB" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Pipeline ), SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.no-pipeline" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.no-pipeline" ) ), "{scope}", [Scope Text] ),
			        COUNTROWS ( 'Country' ) > 1, Main & TopPart,
			        Main & "."
			    )
		displayFolder: Headlines

	measure 'Headline Opportunity' =
			VAR TopBuilder = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Country'[Country ID] ), "@Construction", [Construction GW] ), [@Construction], DESC )
			VAR TopGW = MAXX ( TopBuilder, [@Construction] )
			VAR Sentence =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( COUNTROWS ( 'Country' ) > 1, IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.claim" ) ), IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.neutral" ) ) ), "{top_builder}", MAXX ( TopBuilder, IF ( [Language Code] = "ar", CALCULATE ( MAX ( 'Country'[Country AR] ) ), CALCULATE ( MAX ( 'Country'[Country] ) ) ) ) ), "{top_builder_gw}", IF ( TopGW > 0 && TopGW < 0.05, "<0.1", FORMAT ( TopGW, "#,0.0", "en-GB" ) ) ), "{top_builder_share}", FORMAT ( MAXX ( TopBuilder, [Wind Solar Share %] ), "0.0%", "en-GB" ) ), "{year}", MAXX ( TopBuilder, [Ember Year] ) )
			RETURN
			    IF ( TopGW > 0, Sentence, SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.opportunity.none" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.opportunity.none" ) ), "{scope}", [Scope Text] ) )
		displayFolder: Headlines

	measure 'Headline Detail' =
			VAR Projects = FILTER ( ADDCOLUMNS ( VALUES ( 'Unit'[Plant ID] ), "@Pipeline", [Pipeline GW] ), [@Pipeline] > 0 )
			VAR ProjectCount = COUNTROWS ( Projects )
			VAR Top10Share = DIVIDE ( SUMX ( TOPN ( 10, Projects, [@Pipeline], DESC ), [@Pipeline] ), [Pipeline GW] )
			VAR HydrogenShare = [Hydrogen % of Pipeline]
			VAR Main =
			    IF (
			        ProjectCount > 10,
			        SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.claim" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.claim" ) ), "{top10_pct}", FORMAT ( Top10Share, "0.0%", "en-GB" ) ), "{scope_pos}", [Scope Possessive Text] ),
			        IF (
			            ProjectCount = 1,
			            SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.neutral-single" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.neutral-single" ) ), "{scope}", [Scope Text] ),
			            SUBSTITUTE ( SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.neutral" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.neutral" ) ), "{projects}", FORMAT ( ProjectCount, "0" ) ), "{scope}", [Scope Text] )
			        )
			    )
			VAR HydrogenPart = SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.detail.hydrogen" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.detail.hydrogen" ) ), "{hydrogen_pct}", FORMAT ( HydrogenShare, "0.0%", "en-GB" ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ProjectCount = 0 || ISBLANK ( ProjectCount ), SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "headline.no-pipeline" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "headline.no-pipeline" ) ), "{scope}", [Scope Text] ),
			        HydrogenShare > 0, Main & HydrogenPart,
			        Main & "."
			    )
		displayFolder: Headlines

	measure 'Footer Refreshed' = SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "footer.refreshed" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "footer.refreshed" ) ), "{date}", FORMAT ( MAX ( 'Refresh Info'[Refreshed At UTC] ), "dd mmm yy, HH:mm", "en-GB" ) )
		displayFolder: Footer

	measure 'Footer Data To' =
			VAR FirstYear = CALCULATE ( MIN ( 'Country'[Ember Latest Year] ), REMOVEFILTERS ( 'Country' ) )
			VAR LastYear = CALCULATE ( MAX ( 'Country'[Ember Latest Year] ), REMOVEFILTERS ( 'Country' ) )
			VAR Years = IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "–" & FORMAT ( LastYear, "0" ) )
			RETURN
			    SUBSTITUTE ( IF ( [Language Code] = "ar", LOOKUPVALUE ( 'Translations'[ar], 'Translations'[key], "footer.data-to" ), LOOKUPVALUE ( 'Translations'[en], 'Translations'[key], "footer.data-to" ) ), "{years}", Years )
		displayFolder: Footer

	measure 'Technology Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Technology'[Group Sort Order] ),
			    1, "#eda100",
			    2, "#1baf7a",
			    3, "#2a78d6",
			    4, "#b3b2ac"
			)
		isHidden
		displayFolder: Formatting

	measure 'Technology Colour Faded' =
			SWITCH (
			    SELECTEDVALUE ( 'Technology'[Group Sort Order] ),
			    1, "#f8d999",
			    2, "#a4dfca",
			    3, "#aac9ef",
			    4, "#e1e0de"
			)
		isHidden
		displayFolder: Formatting

	measure 'Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Status'[Status ID] ),
			    "operating", "#2b2570",
			    "construction", "#4a3fb0",
			    "pre-construction", "#7368d9",
			    "announced", "#a49cea",
			    "shelved", "#9e9d97",
			    "cancelled", "#9e9d97",
			    "#d3d2cc"
			)
		isHidden
		displayFolder: Formatting

	measure 'Status Colour Faded' =
			SWITCH (
			    SELECTEDVALUE ( 'Status'[Status ID] ),
			    "operating", "#aaa8c6",
			    "construction", "#b7b2df",
			    "pre-construction", "#c7c3f0",
			    "announced", "#dbd7f7",
			    "shelved", "#d8d8d5",
			    "cancelled", "#d8d8d5",
			    "#e1e0de"
			)
		isHidden
		displayFolder: Formatting

	measure 'Accent Colour' = "#eb6834"
		isHidden
		displayFolder: Formatting

	measure 'Neutral Colour' = "#d3d2cc"
		isHidden
		displayFolder: Formatting

	measure 'Ember Year' =
			IF (
			    ISFILTERED ( 'Generation'[Year] ),
			    FORMAT ( SELECTEDVALUE ( 'Generation'[Year] ), "0" ),
			    VAR FirstYear = MIN ( 'Country'[Ember Latest Year] )
			    VAR LastYear = MAX ( 'Country'[Ember Latest Year] )
			    RETURN
			        IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0" ), FORMAT ( FirstYear, "0" ) & "–" & FORMAT ( LastYear, "0" ) )
			)
		displayFolder: Generation

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source
